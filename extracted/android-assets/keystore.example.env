# Signature de release. NE PAS COMMITER DE VALEURS RÉELLES.
#
# 1) Créer la clé (une seule fois, à conserver précieusement) :
#      keytool -genkeypair -v -keystore ~/dz-rami-release.jks -alias dz-rami \
#        -keyalg RSA -keysize 2048 -validity 10000
#
# 2) Exporter ces variables avant ./gradlew assembleRelease :
#      set -a; . ./android-assets/keystore.env; set +a
#
# Sans ces variables, l'APK de release n'est pas signé (installable pour tester,
# mais pas distribuable).
DZ_KEYSTORE_FILE=/chemin/absolu/vers/dz-rami-release.jks
DZ_KEYSTORE_PASSWORD=mot-de-passe-du-keystore
DZ_KEY_ALIAS=dz-rami
DZ_KEY_PASSWORD=mot-de-passe-de-la-cle
